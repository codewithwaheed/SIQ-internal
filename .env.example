# Application Configuration
VITE_APP_NAME=SentrIQ
VITE_APP_VERSION=1.0.0

# Development Only (Public)
VITE_DEV_MODE=true

# ======================================
# BACKEND SECRETS (Supabase Edge Functions Only)
# These should NEVER be prefixed with VITE_
# Configure these in Supabase Dashboard → Settings → Edge Functions
# ======================================

# Supabase Service Configuration (Private)
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=your-anonymous-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# SUPABASE_DB_URL=postgresql://postgres:[password]@db.your-project-id.supabase.co:5432/postgres

# External API Keys (Private)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_API_MODEL=gpt-4o-mini

# Qdrant Configuration (Private)
QDRANT_URL=https://YOUR-QDRANT-ENDPOINT
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=user_docs
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DIM=1536
DISABLE_EMBEDDINGS=0
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# When generating signed URLs server-side for OpenAI (image analysis),
# override the storage host to a publicly reachable base. For local dev,
# set this to your public tunnel (e.g., https://abc123.ngrok.io).
# For hosted Supabase, leave empty.
PUBLIC_STORAGE_BASE_URL=
# STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# Security Configuration (Private)
# JWT_SECRET=your-jwt-secret-here
# ENCRYPTION_KEY=your-encryption-key-here

# ======================================
# DEPLOYMENT ENVIRONMENTS
# ======================================

# Production Environment Variables:
# - Use live API keys (sk_live_, pk_live_)
# - Set VITE_DEV_MODE=false
# - Use production Supabase project
# - Configure real domain callbacks

# Staging Environment Variables:
# - Use test API keys (sk_test_, pk_test_)
# - Set VITE_DEV_MODE=true
# - Use separate Supabase project
# - Configure staging domain callbacks

# ======================================
# SECURITY NOTES
# ======================================

# 1. Frontend variables (VITE_*) are exposed to the browser
# 2. Backend variables (no prefix) are server-side only
# 3. Never commit actual values to version control
# 4. Rotate keys regularly for security
# 5. Use different values for staging and production
# 6. Monitor usage and set up alerts for unusual activity
